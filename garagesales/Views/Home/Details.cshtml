@using garagesales.Models
@using System.Security.Claims
@model GarageSale
@{
    var userid = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var role = User.FindFirstValue(ClaimTypes.Role);

}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            @if (Model.UserId == userid || role == "Admin")
            {
                <div class="text-center mb-3">
                    <a asp-controller="Home" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="fa-solid fa-trash me-1"></i>
                        Delete Garage Sale
                    </a>
                </div>
            }
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h1 class="card-title mb-1">@Model.Name</h1>
                            <p class="text-muted mb-0">Garage Sale </p>
                        </div>
                        <span class="badge bg-primary fs-6"> @Model.StartTime.ToString("MMM d") </span>
                    </div>
                    <hr />
                    <h5>About This Sale</h5>
                    <p class="text-muted">@Model.Description </p>
                    <div class="row mt-4">
                        <div class="col-md-6 mb-3">
                            <h6 class="text-muted">Address</h6>
                            <p class="mb-0"> @Model.Address
                                <br />
                                @Model.City, @Model.State @Model.ZipCode
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <h6 class="text-muted">Date & Time</h6>
                            <p class="mb-0">
                                <strong>Starts:</strong> @Model.StartTime.ToString("MMMM d, yyyy h:mm tt")
                                <br />
                                <strong>Ends:</strong> @Model.EndTime.ToString("MMMM d, yyyy h:mm tt")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h3 class="mb-0">Items for Sale</h3>
                </div>

                <div class="card-body">
                    <div id="inventory">
                    @if (Model.GarageSaleItems != null && Model.GarageSaleItems.Any())
                    {
                        <div class="row g-3">
                            @foreach (var item in Model.GarageSaleItems)
                            {
                                <div class="col-md-6">
                                    <div class="card h-100 border">
                                        <div class="card-body position-relative">
                                                @if (Model.UserId == userid || role == "Admin")
                                                {   
                                                <a asp-controller="Home" asp-action="DeleteItem" asp-route-saleid="@Model.Id" asp-route-itemid="@item.Id" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2"> <i class="fa-solid fa-trash"></i> </a>
                                                }
                                            <h5 class="card-title">
                                                @item.Name
                                            </h5>

                                            <p class="card-text text-muted">
                                                @item.Description
                                            </p>

                                            <div class="mt-3">
                                                <span class="badge bg-success fs-6">
                                                    $@item.Price.ToString("0.00")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted mb-0">
                                No items have been added to this garage sale yet.
                            </p>
                        </div>
                    }
                        @if (Model.UserId == userid)
                        {
                            <i onclick="addItem(@Model.Id)" style="cursor: pointer;" class="fa-solid fa-circle-plus text-success fs-3"></i>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-controller="home"asp-action="Index" class="btn btn-secondary">Back to Garage Sales </a>
            </div>

        </div>
    </div>
</div>
<script>
    function addItem(saleid){
        $.get("/Home/AddItem", {saleid: saleid}, 
        function (html) {
            $("#inventory").html(html)
        })
    }
</script>