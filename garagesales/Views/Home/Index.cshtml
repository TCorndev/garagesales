@using garagesales.Models
@model List<GarageSale>
@{
    ViewData["Title"] = "Home Page";
}

<div class="list-group">
    @foreach (var sale in Model)
    {
        <div class="list-group-item">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="mb-1"><a asp-controller="Home" asp-action="Details" asp-route-id="@sale.Id">@sale.Name</a></h5>

                    <div class="text-muted small">
                        <div>
                            <i class="fa-solid fa-location-dot me-1"></i>
                            @sale.Address
                        </div>
                        <div>
                            <i class="fa-solid fa-clock me-1"></i>
                            @sale.StartTime.ToString("g")
                        </div>
                    </div>
                </div>
            </div>

            @if (sale.GarageSaleItems != null && sale.GarageSaleItems.Any())
            {
                <div class="mt-3 ms-3">
                    <div class="small text-muted fw-semibold mb-1">Items</div>

                    <ul class="list-unstyled mb-0">
                        @foreach (var item in sale.GarageSaleItems)
                        {
                            <li class="small text-secondary">
                                <i class="fa-solid fa-tag me-1"></i>
                                @item.Name
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="mt-2 ms-3 small text-muted">
                    No items listed.
                </div>
            }
        </div>
    }
</div>